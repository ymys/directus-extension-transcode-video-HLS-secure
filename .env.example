# --- Directus Hosting Configuration ---
# The public URL of your Directus instance. Used to download source files from cloud storage.
PUBLIC_URL="http://localhost:8055"
HOST="0.0.0.0"
PORT=8055

# --- Storage Configuration ---
# Comma-separated list of storage locations configured in Directus
STORAGE_LOCATIONS="local,s3"

# Local Storage Driver
STORAGE_LOCAL_DRIVER="local"
STORAGE_LOCAL_ROOT="./uploads"

# Optional Cloud Storage (Example for S3)
# STORAGE_S3_DRIVER="s3"
# STORAGE_S3_KEY="your-access-key"
# STORAGE_S3_SECRET="your-secret-key"
# STORAGE_S3_BUCKET="your-bucket-name"
# STORAGE_S3_REGION="us-east-1"
# STORAGE_S3_ENDPOINT="https://s3.amazonaws.com"

# --- AI Auto-Transcription Configuration (Optional) ---
# Required only if using the "Cloud API" transcription engine.
# Supports OpenAI, Groq, Anthropic (via proxy), Ollama, etc.
# AI_TRANSCRIPTION_API_KEY="your-api-key-here"

# Base URL for the OpenAI-compatible transcription service. 
# Defaults to OpenAI: https://api.openai.com/v1
# For Groq: https://api.groq.com/openai/v1
# For Ollama: http://localhost:11434/v1
# AI_TRANSCRIPTION_BASE_URL="https://api.openai.com/v1"

# --- Extension Specific Configuration (Environment Overrides) ---
# Override the path to FFmpeg/FFprobe binaries if they are not in the system PATH.
# FFMPEG_PATH="/usr/bin/ffmpeg"
# FFPROBE_PATH="/usr/bin/ffprobe"
