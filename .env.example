# Directus Hosting Configuration
PUBLIC_URL="http://localhost:8055"
HOST="0.0.0.0"
PORT=8055

# Storage Configuration
# Comma-separated list of storage locations (e.g. "local,r2,r2_private,s3")
STORAGE_LOCATIONS="local,r2,r2_private,s3"

# Local Storage Driver
STORAGE_LOCAL_DRIVER="local"
STORAGE_LOCAL_ROOT="./uploads"

# Cloudflare R2 Storage - Public / HLS (S3-compatible driver)
# STORAGE_R2_DRIVER="s3"
# STORAGE_R2_KEY="your-r2-access-key-id"
# STORAGE_R2_SECRET="your-r2-secret-access-key"
# STORAGE_R2_BUCKET="your-r2-bucket-name"
# STORAGE_R2_REGION="auto"
# STORAGE_R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# STORAGE_R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
# STORAGE_R2_S3_FORCE_PATH_STYLE="true"
# STORAGE_R2_FORCE_PATH_STYLE="true"

# Cloudflare R2 Storage - Private Original Source Archive (S3-compatible driver)
# STORAGE_R2_PRIVATE_DRIVER="s3"
# STORAGE_R2_PRIVATE_KEY="your-private-r2-access-key-id"
# STORAGE_R2_PRIVATE_SECRET="your-private-r2-secret-access-key"
# STORAGE_R2_PRIVATE_BUCKET="your-private-r2-bucket-name"
# STORAGE_R2_PRIVATE_REGION="auto"
# STORAGE_R2_PRIVATE_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# STORAGE_R2_PRIVATE_S3_FORCE_PATH_STYLE="true"
# STORAGE_R2_PRIVATE_FORCE_PATH_STYLE="true"

# Optional Cloud Storage (Example for S3)
# STORAGE_S3_DRIVER="s3"
# STORAGE_S3_KEY="your-key"
# STORAGE_S3_SECRET="your-secret"
# STORAGE_S3_BUCKET="your-bucket"
# STORAGE_S3_REGION="your-region"
# STORAGE_S3_ENDPOINT="your-endpoint"

# Extension Specific Configuration (Environment Overrides)
# FFMPEG_PATH="/usr/bin/ffmpeg"
# FFPROBE_PATH="/usr/bin/ffprobe"

# AI Caption & Transcription Configuration
# TRANSCRIBE_API_ENDPOINT="https://ainote-2026-resource.cognitiveservices.azure.com/openai/deployments/whisper/audio/translations?api-version=2024-06-01"
# TRANSCRIBE_API_KEY="your-api-key"
# TRANSCRIBE_API_TYPE="azure"

